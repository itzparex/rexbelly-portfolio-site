    <script>
      import { frameworkWorkflows } from "../data/framework-content";

      const root = document.documentElement;
      const workflowCards = [...document.querySelectorAll("[data-workflow-id]")];
      const roadmapList = document.querySelector("#roadmap-list");
      const researchHub = document.querySelector("#research-hub");
      const researchTabs = [...document.querySelectorAll("[data-research-tab]")];
      const researchPanels = [...document.querySelectorAll("[data-research-panel]")];
      const workspaceTitle = document.querySelector("#workspace-title");
      const workflowIntro = document.querySelector("#workflow-intro");
      const stageCount = document.querySelector("#stage-count");
      const taskSelect = document.querySelector("#task-select");
      const taskSummary = document.querySelector("#task-summary");
      const primaryFields = document.querySelector("#primary-fields");
      const optionalFields = document.querySelector("#optional-fields");
      const optionalFieldsList = document.querySelector("#optional-fields-list");
      const modeControls = document.querySelector("#mode-controls");
      const modeStatic = document.querySelector("#mode-static");
      const promptPreview = document.querySelector("#prompt-preview");
      const copyStatus = document.querySelector("#copy-status");
      const projectContext = document.querySelector("#project-context");
      const exampleDescription = document.querySelector("#example-description");
      const copyButton = document.querySelector("#copy-prompt");
      const pilotPrompt = document.querySelector("#pilot-prompt-template");
      const pilotCopyStatus = document.querySelector("#pilot-copy-status");
      const pageState = new Map();
      let activeWorkflow = frameworkWorkflows[0];
      let activeTask = activeWorkflow.tasks[0];
      let activeStage = 0;
      let activeMode = "plan";
      let copyStatusTimer;

      const getTaskKey = (workflow, task) => `${workflow.id}:${task.id}`;
      const getTaskState = (workflow, task) => pageState.get(getTaskKey(workflow, task)) ?? {};
      const setTaskState = (workflow, task, values) => pageState.set(getTaskKey(workflow, task), values);

      const updatePrompt = () => {
        const values = getTaskState(activeWorkflow, activeTask);
        const missing = activeTask.fields
          .filter((field) => !field.optional && !values[field.key]?.trim())
          .map((field) => `[Add ${field.label}]`);
        const inputs = activeTask.fields
          .filter((field) => values[field.key]?.trim())
          .map((field) => `${field.label} — ${values[field.key].trim()}`);
        const context = projectContext.value.trim();
        const mode = activeTask.mode === "build"
          ? activeMode
          : activeTask.mode === "read-only"
            ? "Read-only audit"
            : activeTask.mode === "research"
              ? "Research"
              : "Draft";

        promptPreview.value = [
          `Help me with ${activeWorkflow.title} → ${activeTask.title}. Work in ${mode} mode.`,
          "",
          `Goal — ${activeTask.summary}`,
          "",
          `Inputs — ${inputs.length ? inputs.join("\n") : "No task details supplied yet."}${missing.length ? `\nMissing required inputs — ${missing.join(", ")}` : ""}`,
          context ? `\nProject context — ${context}` : "",
          `\nConstraints — ${activeTask.constraints} Goals, done criteria, and release approval stay with me. Require explicit approval before changes involving checkout, customer data, external writes, or production access.${context ? ` Project context and rules: ${context}` : ""}`,
          `\nDeliver — ${activeTask.deliver}`,
          `\nVerify — ${activeTask.verify} Use a focused accuracy-and-tone check for copy-only changes; verify relevant behavior and responsive states for feature changes. Report checks that could not run.`,
          missing.length ? `\nIf a missing required input blocks meaningful work, ask only for that input before proceeding. Do not guess.` : "",
        ].filter(Boolean).join("\n");
        copyStatus.textContent = "";
      };

      const renderRoadmap = () => {
        roadmapList.replaceChildren();
        activeWorkflow.stages.forEach((stage, index) => {
          const item = document.createElement("li");
          item.className = `framework-stage${index === activeStage ? " is-active is-expanded" : ""}`;
          if (stage.anchorId) item.id = stage.anchorId;
          const connector = document.createElement("span");
          connector.className = "framework-stage-connector";
          connector.setAttribute("aria-hidden", "true");
          const trigger = document.createElement("button");
          trigger.className = "framework-stage-trigger";
          trigger.type = "button";
          trigger.setAttribute("aria-expanded", String(index === activeStage));
          trigger.innerHTML = `<span class="framework-stage-index">${String(index + 1).padStart(2, "0")}</span><span class="framework-stage-title"></span><span class="framework-stage-state"></span><span class="framework-stage-chevron" aria-hidden="true">⌄</span>`;
          trigger.querySelector(".framework-stage-title").textContent = stage.title;
          trigger.querySelector(".framework-stage-state").textContent = index === activeStage ? "ACTIVE" : "NEXT";
          trigger.addEventListener("click", () => {
            activeStage = index;
            renderRoadmap();
          });
          const content = document.createElement("div");
          content.className = "framework-stage-content";
          content.hidden = index !== activeStage;
          for (const [label, text] of [
            ["What I do", stage.do],
            ["What AI helps with", stage.ai],
            ["What I check", stage.check],
          ]) {
            const detail = document.createElement("div");
            detail.className = "framework-stage-detail";
            const title = document.createElement("span");
            title.textContent = label;
            const paragraph = document.createElement("p");
            paragraph.textContent = text;
            detail.append(title, paragraph);
            content.append(detail);
          }
          const useButton = document.createElement("button");
          useButton.className = "framework-stage-use";
          useButton.type = "button";
          useButton.dataset.taskId = stage.taskId ?? activeWorkflow.tasks[0].id;
          useButton.innerHTML = "Use this prompt <span aria-hidden=\"true\">→</span>";
          content.append(useButton);
          item.append(connector, trigger, content);
          roadmapList.append(item);
        });
      };

      const makeField = (field, values) => {
        const wrapper = document.createElement("div");
        wrapper.className = "framework-form-field";
        const label = document.createElement("label");
        label.className = "framework-field-label";
        label.textContent = field.label;
        const input = document.createElement("textarea");
        input.rows = 2;
        input.name = field.key;
        input.placeholder = field.placeholder;
        input.value = values[field.key] ?? "";
        input.required = !field.optional;
        input.setAttribute("aria-label", field.label);
        if (!field.optional) {
          const requiredMark = document.createElement("span");
          requiredMark.textContent = "Required";
          label.append(requiredMark);
        } else {
          const optionalMark = document.createElement("span");
          optionalMark.textContent = "Optional";
          label.append(optionalMark);
        }
        wrapper.append(label, input);
        input.addEventListener("input", () => {
          setTaskState(activeWorkflow, activeTask, {
            ...getTaskState(activeWorkflow, activeTask),
            [field.key]: input.value,
          });
          updatePrompt();
        });
        return wrapper;
      };

      const renderTask = () => {
        activeTask = activeWorkflow.tasks.find((task) => task.id === taskSelect.value) ?? activeWorkflow.tasks[0];
        taskSelect.value = activeTask.id;
        taskSummary.textContent = activeTask.summary;
        const values = getTaskState(activeWorkflow, activeTask);
        primaryFields.replaceChildren();
        optionalFieldsList.replaceChildren();
        optionalFields.hidden = !activeTask.fields.some((field) => field.optional);
        for (const field of activeTask.fields) {
          (field.optional ? optionalFieldsList : primaryFields).append(makeField(field, values));
        }
        const isBuild = activeTask.mode === "build";
        modeControls.hidden = !isBuild;
        modeStatic.hidden = isBuild;
        modeStatic.textContent = activeTask.mode === "read-only"
          ? "Read-only"
          : activeTask.mode === "research"
            ? "Research"
            : "Draft";
        activeMode = "plan";
        modeControls.querySelectorAll("[data-mode]").forEach((button) => {
          button.classList.toggle("is-active", button.dataset.mode === activeMode);
          button.setAttribute("aria-pressed", String(button.dataset.mode === activeMode));
        });
        exampleDescription.textContent = activeTask.id === activeWorkflow.exampleTaskId
          ? activeWorkflow.exampleDescription
          : `${activeTask.title} example · ${Object.keys(activeTask.example).length} inputs ready to load.`;
        updatePrompt();
      };

      const selectTask = (taskId) => {
        if (!activeWorkflow.tasks.some((task) => task.id === taskId)) return;
        taskSelect.value = taskId;
        renderTask();
        document.querySelector("#prompt-panel-title").scrollIntoView({ behavior: "smooth", block: "nearest" });
      };

      const selectWorkflow = (workflowId) => {
        const nextWorkflow = frameworkWorkflows.find((workflow) => workflow.id === workflowId);
        if (!nextWorkflow) return;
        activeWorkflow = nextWorkflow;
        activeStage = 0;
        researchHub.hidden = workflowId !== "research";
        workflowCards.forEach((card) => {
          const selected = card.dataset.workflowId === workflowId;
          card.classList.toggle("is-active", selected);
          card.setAttribute("aria-pressed", String(selected));
        });
        workspaceTitle.textContent = activeWorkflow.title;
        workflowIntro.textContent = activeWorkflow.intro;
        stageCount.textContent = `${activeWorkflow.stages.length} stages`;
        taskSelect.replaceChildren(...activeWorkflow.tasks.map((task) => {
          const option = document.createElement("option");
          option.value = task.id;
          option.textContent = task.title;
          return option;
        }));
        taskSelect.value = activeWorkflow.exampleTaskId;
        renderRoadmap();
        renderTask();
      };

      const selectResearchTab = (tabName, focus = false) => {
        researchTabs.forEach((tab) => {
          const selected = tab.dataset.researchTab === tabName;
          tab.classList.toggle("is-active", selected);
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focus) tab.focus();
        });
        researchPanels.forEach((panel) => {
          panel.hidden = panel.dataset.researchPanel !== tabName;
        });
      };

      const sampleProducts = {
        "garden-shoes": {
          title: "Garden shoes",
          brand: "Example garden goods",
          description: "Illustrative gardening footwear product",
          market: "United States · English",
          channel: "Product page",
          offer: "Not supplied in this example; terms need owner confirmation.",
          proof: "Example only; no customer evidence attached.",
          decision: "Which verified product benefits should the research investigate?",
          sources: [{ id: "S01", title: "Example review notes", note: "Illustrative source only · no real customer data" }],
          stages: [
            ["01 · Customer Deep Dive", "Draft", "01-deep-dive-v1.md · Sample"],
            ["02 · Marketer’s Booklet", "Needs review", "02-marketers-booklet-v1.md · Sample"],
            ["04 · Offer Strategy", "Not started", "No sample file"],
            ["06 · Proof & Belief", "Not started", "No sample file"],
            ["07 · Conversion Strategy", "Not started", "No sample file"],
          ],
        },
        "garden-cart": {
          title: "Portable garden cart",
          brand: "Illustrative outdoor tools",
          description: "Sample product record for a portable garden cart",
          market: "Canada · English",
          channel: "Email",
          offer: "Example only; no approved offer or commercial terms.",
          proof: "No evidence attached in this sample.",
          decision: "Which sourced customer problem should the next email address?",
          sources: [{ id: "S01", title: "Example product notes", note: "Illustrative source only · no real customer data" }],
          stages: [
            ["01 · Customer Deep Dive", "Approved", "01-deep-dive-v1-CA.md · Canada · v1 · Approved sample"],
            ["02 · Marketer’s Booklet", "Draft", "v1 retained · 02-marketers-booklet-v2-CA.md · Canada · v2 · Draft sample"],
            ["04 · Offer Strategy", "Not started", "No sample file"],
            ["06 · Proof & Belief", "Not started", "No sample file"],
            ["07 · Conversion Strategy", "Not started", "No sample file"],
          ],
        },
      };

      const sampleStatusClass = (status) => ({
        "Not started": "status--not-started",
        Draft: "status--draft",
        "Needs review": "status--review",
        Approved: "status--approved",
      })[status] ?? "status--not-started";

      const renderSampleProduct = (productId) => {
        const product = sampleProducts[productId];
        if (!product) return;
        document.querySelectorAll("[data-sample-product]").forEach((button) => {
          const selected = button.dataset.sampleProduct === productId;
          button.classList.toggle("is-active", selected);
          button.setAttribute("aria-pressed", String(selected));
        });
        document.querySelector("#sample-product-title").textContent = product.title;
        document.querySelector("#sample-product-brief").replaceChildren(
          ...[
            ["Brand", product.brand],
            ["Description / URL", product.description],
            ["Market & language", product.market],
            ["Intended channel", product.channel],
            ["Offer & constraints", product.offer],
            ["Available proof", product.proof],
            ["Next decision", product.decision],
            ["Updated", "Sample timestamp · no record is saved"],
          ].map(([label, value]) => {
            const row = document.createElement("div");
            const term = document.createElement("dt");
            const description = document.createElement("dd");
            term.textContent = label;
            description.textContent = value;
            row.append(term, description);
            return row;
          }),
        );
        document.querySelector("#sample-source-count").textContent = `${product.sources.length} example`;
        document.querySelector("#sample-source-list").replaceChildren(
          ...product.sources.map((source) => {
            const row = document.createElement("div");
            row.className = "workspace-file-row";
            const sourceId = document.createElement("span");
            sourceId.className = "workspace-file-kind";
            sourceId.textContent = source.id;
            const details = document.createElement("span");
            const title = document.createElement("strong");
            const note = document.createElement("small");
            title.textContent = source.title;
            note.textContent = source.note;
            details.append(title, note);
            row.append(sourceId, details);
            return row;
          }),
        );
        document.querySelector("#sample-stage-list").replaceChildren(
          ...product.stages.map(([label, status, file], index) => {
            const row = document.createElement("li");
            const link = document.createElement("a");
            const stage = frameworkWorkflows.find((workflow) => workflow.id === "research").stages[index];
            const statusLabel = document.createElement("span");
            const fileLabel = document.createElement("small");
            link.href = `#${stage.anchorId}`;
            link.textContent = label;
            statusLabel.className = `workspace-stage-status ${sampleStatusClass(status)}`;
            statusLabel.textContent = status;
            fileLabel.textContent = file;
            row.append(link, statusLabel, fileLabel);
            return row;
          }),
        );
      };

      document.querySelectorAll("[data-research-tab]").forEach((tab) => {
        tab.addEventListener("click", () => selectResearchTab(tab.dataset.researchTab));
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          const currentIndex = researchTabs.indexOf(tab);
          const nextIndex = (currentIndex + (event.key === "ArrowRight" ? 1 : researchTabs.length - 1)) % researchTabs.length;
          selectResearchTab(researchTabs[nextIndex].dataset.researchTab, true);
        });
      });

      document.addEventListener("click", (event) => {
        const stageLink = event.target.closest('a[href^="#stage-"]');
        if (!stageLink) return;
        const research = frameworkWorkflows.find((workflow) => workflow.id === "research");
        const stageIndex = research.stages.findIndex((stage) => `#${stage.anchorId}` === stageLink.getAttribute("href"));
        if (stageIndex < 0) return;
        event.preventDefault();
        selectWorkflow("research");
        activeStage = stageIndex;
        renderRoadmap();
        taskSelect.value = research.stages[stageIndex].taskId;
        renderTask();
        selectResearchTab("guide");
        history.replaceState(null, "", stageLink.getAttribute("href"));
        document.querySelector(stageLink.getAttribute("href"))?.scrollIntoView({ behavior: "smooth", block: "center" });
      });

      document.querySelectorAll("[data-sample-product]").forEach((button) => {
        button.addEventListener("click", () => renderSampleProduct(button.dataset.sampleProduct));
      });

      document.querySelector("#copy-pilot-prompt").addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pilotPrompt.value);
          pilotCopyStatus.textContent = "Copied. Replace [PRODUCT-FOLDER] before dispatching.";
        } catch {
          pilotPrompt.focus();
          pilotPrompt.select();
          pilotCopyStatus.textContent = "Clipboard unavailable. The prompt is selected so you can copy it.";
        }
      });

      const loadExample = () => {
        setTaskState(activeWorkflow, activeTask, { ...activeTask.example });
        primaryFields.replaceChildren();
        optionalFieldsList.replaceChildren();
        for (const field of activeTask.fields) {
          (field.optional ? optionalFieldsList : primaryFields).append(makeField(field, activeTask.example));
        }
        if (activeTask.fields.some((field) => field.optional)) optionalFields.open = true;
        updatePrompt();
      };

      roadmapList.addEventListener("click", (event) => {
        const useButton = event.target.closest("[data-task-id]");
        if (useButton) selectTask(useButton.dataset.taskId);
      });
      workflowCards.forEach((card) => card.addEventListener("click", () => selectWorkflow(card.dataset.workflowId)));
      taskSelect.addEventListener("change", renderTask);
      projectContext.addEventListener("input", updatePrompt);
      modeControls.addEventListener("click", (event) => {
        const button = event.target.closest("[data-mode]");
        if (!button) return;
        activeMode = button.dataset.mode;
        modeControls.querySelectorAll("[data-mode]").forEach((modeButton) => {
          const selected = modeButton === button;
          modeButton.classList.toggle("is-active", selected);
          modeButton.setAttribute("aria-pressed", String(selected));
        });
        updatePrompt();
      });
      document.querySelector("#load-example").addEventListener("click", loadExample);
      copyButton.addEventListener("click", async () => {
        window.clearTimeout(copyStatusTimer);
        try {
          await navigator.clipboard.writeText(promptPreview.value);
          copyStatus.textContent = "Copied. Your prompt is ready to paste.";
          copyButton.classList.add("is-copied");
          copyStatusTimer = window.setTimeout(() => copyButton.classList.remove("is-copied"), 1800);
        } catch {
          promptPreview.focus();
          promptPreview.select();
          copyStatus.textContent = "Clipboard access was unavailable. The prompt is selected for you to copy.";
        }
      });

      const savedTheme = localStorage.getItem("rexbelly-theme");
      const themeButton = document.querySelector(".framework-theme-toggle");
      const themeColor = document.querySelector('meta[name="theme-color"]');
      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        themeButton.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} theme`);
        themeColor.setAttribute("content", theme === "dark" ? "#151512" : "#f6f5f1");
      };
      if (savedTheme === "light" || savedTheme === "dark") applyTheme(savedTheme);
      themeButton.addEventListener("click", () => {
        const theme = root.dataset.theme === "dark" ? "light" : "dark";
        applyTheme(theme);
        localStorage.setItem("rexbelly-theme", theme);
      });

      renderTask();
      renderSampleProduct("garden-shoes");
    </script>
  </body>
</html>
