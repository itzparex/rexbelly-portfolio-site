                  <div class="workspace-stage-statuses">
                    <div class="framework-panel-heading"><div><span class="framework-panel-kicker">OWNER-RECORDED STATUS</span><h3>Core stages</h3></div><span class="workspace-sample-badge">SAMPLE</span></div>
                    <ol id="sample-stage-list">
                      <li><a href="#stage-ai-customer-deep-dive">01 · Customer Deep Dive</a><span class="workspace-stage-status status--draft">Draft</span><small>01-deep-dive-v1.md · Sample</small></li>
                      <li><a href="#stage-marketers-booklet">02 · Marketer’s Booklet</a><span class="workspace-stage-status status--review">Needs review</span><small>02-marketers-booklet-v1.md · Sample</small></li>
                      <li><a href="#stage-offer-builder">04 · Offer Strategy</a><span class="workspace-stage-status status--not-started">Not started</span><small>No sample file</small></li>
                      <li><a href="#stage-proof-and-belief">06 · Proof &amp; Belief</a><span class="workspace-stage-status status--not-started">Not started</span><small>No sample file</small></li>
                      <li><a href="#stage-conversion-strategy">07 · Conversion Strategy</a><span class="workspace-stage-status status--not-started">Not started</span><small>No sample file</small></li>
