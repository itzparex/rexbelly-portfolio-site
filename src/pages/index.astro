const funnelCount = funnelGroups.reduce((total, group) => total + group.projects.length, 0);
const projectCount = storefrontProjects.length + websiteProjects.length + funnelCount;

const services = [
  {
    number: "01",
    eyebrow: "SHOPIFY · LIQUID",
