  {
    number: "01",
    eyebrow: "SHOPIFY · LIQUID",
    title: "Storefront & theme development",
    description:
      "From a rough brief to a live, considered storefront. I build Shopify themes, app integrations, and product experiences that work as beautifully as they look.",
    skills: ["Custom themes", "Liquid sections", "APIs & apps", "Launch support"],
  },
