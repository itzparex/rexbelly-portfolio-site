    url: "https://itzparex.github.io/rexbelly-portfolio/#work",
    link: "Explore the case study",
    className: "",
  },
  {
    number: "03",
    type: "INDEPENDENT PROJECT",
    name: "tripninja.io",
    description:
      "An independent travel-tech project, designed, built, and launched as a complete digital experience.",
    image:
      "https://cdn.prod.website-files.com/68338a6e127062351d6e3ca5/6838bdc6a951dba8b488e806_tripninja-map.webp",
    alt: "TripNinja travel map artwork",
    tags: ["Web design", "Front-end", "Independent"],
    url: "https://tripninja.io",
    link: "Visit tripninja.io",
    className: "",
  },
  {
    number: "04",
    type: "SHOPIFY PRODUCT PAGES",
    name: "Winx Wheels",
    description:
      "Product-page work for motorcycle gear, including armored riding pants, a USB-C accessory, and a half-shell helmet.",
    image:
      "https://winxwheels.com/cdn/shop/files/1784566999_0_600x.png?v=5226215491327965039",
