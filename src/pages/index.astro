    <div class="brand-cursor" aria-hidden="true">
      <span class="brand-cursor-orbit"></span>
      <span class="brand-cursor-star">✦</span>
    </div>
    <script>
      import "../scripts/area-animations.js";

      const root = document.documentElement;
      const themeButtons = document.querySelectorAll(".theme-toggle");
      const themeStates = document.querySelectorAll(".theme-state");
      const themeColor = document.querySelector('meta[name="theme-color"]');

      const brandCursor = document.querySelector(".brand-cursor");
      // Keep the native pointer available so modal controls remain easy to target.
      const customCursorEnabled = false;

      if (customCursorEnabled) {
        root.classList.add("has-brand-cursor");

        document.addEventListener("pointermove", (event) => {
          if (event.pointerType !== "mouse") return;

          brandCursor.style.left = `${event.clientX}px`;
          brandCursor.style.top = `${event.clientY}px`;
          brandCursor.classList.add("is-visible");

          const target = event.target instanceof Element ? event.target : null;
          const nativeTarget = target?.closest("input, textarea, select, [contenteditable='true']");
          brandCursor.classList.toggle("is-native", Boolean(nativeTarget));
          brandCursor.classList.toggle(
            "is-interactive",
            Boolean(target?.closest("a, button, [role='button'], [data-cursor-hover]")),
          );
        });

        window.addEventListener("pointerout", (event) => {
          if (!event.relatedTarget) brandCursor.classList.remove("is-visible");
        });

        document.addEventListener("pointerdown", () => brandCursor.classList.add("is-pressed"));
        document.addEventListener("pointerup", () => brandCursor.classList.remove("is-pressed"));
      }

      const dashboardCards = [...document.querySelectorAll(".dashboard-grid > .dashboard-card")];
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const projectReveals = [...document.querySelectorAll("#panel-projects .project-reveal")];

      if (!prefersReducedMotion && "IntersectionObserver" in window) {
        root.classList.add("has-project-reveal");
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -35px 0px" },
        );
        projectReveals.forEach((element) => revealObserver.observe(element));
      }

      const projectFilters = [...document.querySelectorAll("[data-project-filter]")];
      const projectFilterDock = document.querySelector(".project-filters");
      const projectGroups = [...document.querySelectorAll("[data-project-group]")];
      const mobileNavSlot = document.querySelector(".mobile-nav-slot");
      const mobileNav = document.querySelector(".mobile-nav");
      const setMobileNavDocked = (isDocked) => {
        if (!mobileNav || !mobileNavSlot) return;
        const currentlyDocked = mobileNav.classList.contains("is-bottom-docked");
        if (currentlyDocked === isDocked) return;

        if (isDocked) {
          mobileNavSlot.style.height = `${mobileNavSlot.getBoundingClientRect().height}px`;
          mobileNav.classList.add("is-bottom-docked");
        } else {
          mobileNav.classList.remove("is-bottom-docked");
          mobileNavSlot.style.removeProperty("height");
        }
        root.classList.toggle("mobile-nav-pinned", isDocked);
      };

      const updateMobileNavDock = () => {
        if (!mobileNav || !mobileNavSlot) return;
        if (!window.matchMedia("(max-width: 760px)").matches) {
          setMobileNavDocked(false);
          return;
        }

        const slotBottom = mobileNavSlot.getBoundingClientRect().bottom + window.scrollY;
        setMobileNavDocked(window.scrollY > slotBottom);
      };

      window.addEventListener("scroll", updateMobileNavDock, { passive: true });
      window.addEventListener("resize", () => {
        setMobileNavDocked(false);
        updateMobileNavDock();
      });
      requestAnimationFrame(updateMobileNavDock);

      if (projectFilterDock && !prefersReducedMotion && matchMedia("(pointer: fine)").matches) {
        const resetDock = () => {
          projectFilters.forEach((button) => {
            button.style.removeProperty("--dock-scale");
            button.style.removeProperty("--dock-lift");
          });
        };

        projectFilterDock.addEventListener("pointermove", (event) => {
          if (event.pointerType !== "mouse") return;
          projectFilters.forEach((button) => {
            const bounds = button.getBoundingClientRect();
            const distance = Math.abs(event.clientX - (bounds.left + bounds.width / 2));
            const proximity = Math.max(0, 1 - distance / 145);
            const eased = proximity * proximity * (3 - 2 * proximity);
            button.style.setProperty("--dock-scale", (1 + eased * 0.22).toFixed(3));
            button.style.setProperty("--dock-lift", `${(eased * 9).toFixed(1)}px`);
          });
        });
        projectFilterDock.addEventListener("pointerleave", resetDock);
      }

      projectFilters.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.projectFilter;
          projectFilters.forEach((item) => {
            const isActive = item === button;
            item.classList.toggle("is-active", isActive);
            item.setAttribute("aria-pressed", String(isActive));
          });

          projectGroups.forEach((group) => {
            const shouldShow = filter === "all" || group.dataset.projectGroup === filter;
            group.hidden = !shouldShow;
            if (shouldShow) {
              group.classList.remove("is-filtered-in");
              void group.offsetWidth;
              group.classList.add("is-filtered-in");
            }
          });
        });
      });

      const refreshRailControls = () => {
        document.querySelectorAll(".funnel-group").forEach((group) => {
          const rail = group.querySelector(".funnel-rail");
          if (!rail) return;
          const maxScroll = rail.scrollWidth - rail.clientWidth;
          group.querySelectorAll("[data-rail-scroll]").forEach((button) => {
            const atStart = rail.scrollLeft <= 1;
            const atEnd = rail.scrollLeft >= maxScroll - 1;
            button.disabled =
              group.classList.contains("is-expanded") ||
              (button.dataset.direction === "previous" ? atStart : atEnd);
          });
        });
      };

      document.querySelectorAll("[data-rail-scroll]").forEach((button) => {
        button.addEventListener("click", () => {
          const rail = document.getElementById(button.dataset.railScroll);
          if (!rail) return;
          const direction = button.dataset.direction === "previous" ? -1 : 1;
          const distance = Math.max(rail.clientWidth * 0.78, 240) * direction;
          if (prefersReducedMotion) rail.scrollLeft += distance;
          else rail.scrollBy({ left: distance, behavior: "smooth" });
        });
      });

      document.querySelectorAll(".funnel-rail").forEach((rail) => {
        rail.addEventListener("scroll", refreshRailControls, { passive: true });
      });

      document.querySelectorAll("[data-rail-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const rail = document.getElementById(button.dataset.railToggle);
          const group = rail?.closest(".funnel-group");
          const label = button.querySelector(".rail-toggle-label");
          if (!rail || !group || !label) return;

          const expanded = rail.classList.toggle("is-expanded");
          group.classList.toggle("is-expanded", expanded);
          button.setAttribute("aria-expanded", String(expanded));
          label.textContent = expanded
            ? "Show featured"
            : `View all ${rail.querySelectorAll(".funnel-card").length} pages`;
          if (!expanded) rail.scrollLeft = 0;
          requestAnimationFrame(refreshRailControls);
        });
      });
      window.addEventListener("resize", refreshRailControls);

      if (!prefersReducedMotion && typeof Element.prototype.animate === "function") {
        dashboardCards.forEach((card, index) => {
          card.animate(
            [
              { opacity: 0, transform: "translateY(22px) scale(0.985)" },
              { opacity: 1, transform: "translateY(0) scale(1)" },
            ],
            {
              duration: 560,
              delay: index * 75,
              easing: "cubic-bezier(0.23, 1, 0.32, 1)",
            },
          );
        });
      }

      const updateThemeColor = () => {
        const isDark = root.dataset.theme === "dark";
        themeColor.setAttribute("content", isDark ? "#050b14" : "#edf5fa");
      };

      const setTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem("rexbelly-theme", theme);
        themeStates.forEach((state) => {
          state.textContent = theme === "dark" ? "Dark" : "Light";
        });
        themeButtons.forEach((button) => {
          button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} theme`);
        });
        updateThemeColor();
      };

      const savedTheme = localStorage.getItem("rexbelly-theme");
      if (savedTheme === "light" || savedTheme === "dark") setTheme(savedTheme);
      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          setTheme(root.dataset.theme === "dark" ? "light" : "dark");
        });
      });

      const tabPanels = new Map(
        [...document.querySelectorAll(".tab-panel")].map((panel) => [
          panel.id.replace("panel-", ""),
          panel,
        ]),
      );
      const tabTriggers = [...document.querySelectorAll("[data-tab-target]")];
      const serviceDialog = document.querySelector("#service-dialog");
      const serviceDialogTitle = document.querySelector("#service-dialog-title");
      const serviceDialogContent = document.querySelector("#service-dialog-content");
      const serviceOptions = [...document.querySelectorAll("#contact-form input[name='services']")];
      const inquiryEndpoint = "https://script.google.com/macros/s/AKfycbzBNvA1wKIs_6ZCNp6CnJrDLXUpuBO9jCVyTkZDCGgXRk9Hk4Wu88ugLHrQoAstQLaz/exec";
      const brandCursorParent = brandCursor?.parentNode;
      const brandCursorNextSibling = brandCursor?.nextSibling;
      let serviceDialogOpener = null;
      let serviceDialogCloseReason = "restore";
      let serviceContactPending = false;

      const setContactService = (value) => {
        serviceOptions.forEach((option) => {
          option.checked = option.value === value;
        });
      };

      const activateTab = (tabName, { updateHistory = true, focus = false } = {}) => {
        const selectedPanel = tabPanels.get(tabName);
        if (!selectedPanel) return;
        setMobileNavDocked(false);
        updateThemeColor();

        if (tabName === "contact" && !serviceContactPending) {
          setContactService("");
        }

        tabPanels.forEach((panel, name) => {
          const selected = name === tabName;
          panel.hidden = !selected;
          panel.setAttribute("aria-hidden", String(!selected));
        });

        tabTriggers.forEach((trigger) => {
          const selected = trigger.dataset.tabTarget === tabName;
          trigger.classList.toggle("is-active", selected);
          trigger.setAttribute("aria-selected", String(selected));
          trigger.tabIndex = selected ? 0 : -1;
          if (selected) trigger.setAttribute("aria-current", "page");
          else trigger.removeAttribute("aria-current");
        });

        if (tabName === "projects" && !prefersReducedMotion) {
          selectedPanel.classList.remove("is-entering");
          requestAnimationFrame(() => selectedPanel.classList.add("is-entering"));
          window.setTimeout(() => selectedPanel.classList.remove("is-entering"), 1100);
        }

        window.scrollTo(0, 0);
        requestAnimationFrame(refreshRailControls);

        if (updateHistory && location.hash !== `#${tabName}`) {
          history.pushState({ tabName }, "", `#${tabName}`);
        }

        if (focus) {
          tabTriggers.find((trigger) => trigger.dataset.tabTarget === tabName)?.focus();
        }
      };

      const setServiceTopic = (topic) => {
        serviceDialogContent.querySelectorAll("[data-service-topic-tab]").forEach((button) => {
          const selected = button.dataset.serviceTopicTab === topic;
          button.setAttribute("aria-selected", String(selected));
          button.tabIndex = selected ? 0 : -1;
        });
        serviceDialogContent.querySelectorAll("[data-service-topic-panel]").forEach((panel) => {
          panel.hidden = panel.dataset.serviceTopicPanel !== topic;
        });
      };

      const toggleRoadmapStep = (button) => {
        const nextExpanded = button.getAttribute("aria-expanded") !== "true";
        serviceDialogContent.querySelectorAll(".roadmap-step-toggle").forEach((item) => {
          const expanded = item === button && nextExpanded;
          item.setAttribute("aria-expanded", String(expanded));
          const panel = document.getElementById(item.getAttribute("aria-controls"));
          if (panel) panel.hidden = !expanded;
        });
      };

      const openServiceContact = (serviceName) => {
        setContactService(serviceName);
        serviceDialogCloseReason = "contact";
        serviceContactPending = true;
        serviceDialog.close();
        activateTab("contact");
        serviceContactPending = false;
        requestAnimationFrame(() => document.querySelector("#contact-message")?.focus());
      };

      const openExampleLink = (event, link) => {
        if (event.defaultPrevented) return;
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const url = link.getAttribute("href");
        if (!url) return;

        // Open the example explicitly so it works even when the browser blocks
        // target="_blank". If the popup is refused, fall back to the native link.
        const opened = window.open(url, "_blank");
        if (!opened) return;
        opened.opener = null;
        event.preventDefault();
      };

      const openServiceDialog = (serviceId, topic, title, opener) => {
        const template = document.querySelector(`#service-template-${serviceId}`);
        if (!title || !template || !serviceDialog || !serviceDialogContent) return;

        serviceDialogOpener = opener;
        serviceDialogTitle.textContent = title;
        serviceDialogContent.replaceChildren(template.content.cloneNode(true));

        const firstTopic = serviceDialogContent.querySelector("[data-service-topic-tab]")?.dataset.serviceTopicTab;
        if (firstTopic) setServiceTopic(topic || firstTopic);
        serviceDialog.showModal();
        serviceDialog.querySelector(".service-dialog-close").focus();
      };

      // Delegate from the stable content wrapper so controls cloned from a
      // template remain interactive every time the dialog opens.
      serviceDialogContent.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;
        const topicTab = target.closest("[data-service-topic-tab]");
        if (topicTab && serviceDialogContent.contains(topicTab)) {
          event.preventDefault();
          setServiceTopic(topicTab.dataset.serviceTopicTab);
          return;
        }
        const roadmapToggle = target.closest(".roadmap-step-toggle");
        if (roadmapToggle && serviceDialogContent.contains(roadmapToggle)) {
          event.preventDefault();
          toggleRoadmapStep(roadmapToggle);
          return;
        }
        const exampleLink = target.closest(".service-example-links a, .roadmap-credit");
        if (exampleLink && serviceDialogContent.contains(exampleLink)) {
          openExampleLink(event, exampleLink);
          return;
        }
        const serviceContact = target.closest("[data-service-contact]");
        if (serviceContact && serviceDialogContent.contains(serviceContact)) {
          event.preventDefault();
          openServiceContact(serviceContact.dataset.serviceContact);
        }
      });

      document.querySelectorAll("[data-open-service]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          openServiceDialog(
            trigger.dataset.openService,
            trigger.dataset.serviceTopic,
            trigger.dataset.serviceTitle,
            trigger,
          );
        });
      });

      document.querySelectorAll("[data-service-toggle]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const panel = document.getElementById(trigger.getAttribute("aria-controls"));
          const row = trigger.closest(".service-row");
          if (!panel || !row) return;
          const expanded = trigger.getAttribute("aria-expanded") === "true";
          document.querySelectorAll("[data-service-toggle]").forEach((other) => {
            const otherPanel = document.getElementById(other.getAttribute("aria-controls"));
            const otherRow = other.closest(".service-row");
            other.setAttribute("aria-expanded", String(other === trigger && !expanded));
            otherRow?.classList.toggle("is-expanded", other === trigger && !expanded);
            if (otherPanel) {
              const shouldOpen = other === trigger && !expanded;
              if (shouldOpen) {
                otherPanel.hidden = false;
                requestAnimationFrame(() => otherPanel.classList.add("is-open"));
              } else {
                otherPanel.classList.remove("is-open");
                window.setTimeout(() => { otherPanel.hidden = true; }, 220);
              }
            }
          });
          if (!expanded) requestAnimationFrame(() => row.scrollIntoView({ behavior: "smooth", block: "nearest" }));
        });
      });

      document.querySelectorAll(".service-row").forEach((row) => {
        row.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (target?.closest(".service-detail-panel a, .service-detail-panel button, [data-service-toggle]")) return;
          row.querySelector("[data-service-toggle]")?.click();
        });
      });

      serviceDialog.addEventListener("click", (event) => {
        if (event.target !== serviceDialog) return;
        const bounds = serviceDialog.getBoundingClientRect();
        const outside =
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom;
        if (outside) serviceDialog.close();
      });

      serviceDialog.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          serviceDialog.close();
          return;
        }

        const current = event.target.closest("[data-service-topic-tab]");
        if (!current) return;

        const tabs = [...serviceDialogContent.querySelectorAll("[data-service-topic-tab]")];
        const index = tabs.indexOf(current);
        const nextIndex = event.key === "ArrowRight"
          ? (index + 1) % tabs.length
          : event.key === "ArrowLeft"
            ? (index - 1 + tabs.length) % tabs.length
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? tabs.length - 1
                : -1;

        if (nextIndex < 0) return;
        event.preventDefault();
        setServiceTopic(tabs[nextIndex].dataset.serviceTopicTab);
        tabs[nextIndex].focus();
      });

      serviceDialog.querySelector(".service-dialog-close").addEventListener("click", () => {
        serviceDialog.close();
      });

      serviceDialog.addEventListener("close", () => {
        if (customCursorEnabled && brandCursorParent) {
          if (brandCursorNextSibling?.parentNode === brandCursorParent) {
            brandCursorParent.insertBefore(brandCursor, brandCursorNextSibling);
          } else {
            brandCursorParent.append(brandCursor);
          }
        }
        if (serviceDialogCloseReason === "contact") {
          serviceDialogCloseReason = "restore";
          return;
        }
        serviceDialogOpener?.focus();
      });

      const setupStepper = (dialogSel, openSel, hashName) => {
        const breakdown = document.querySelector(dialogSel);
        if (breakdown) {
          const bSteps = [...breakdown.querySelectorAll("[data-breakdown-step]")];
          const bPrev = breakdown.querySelector("[data-breakdown-prev]");
          const bNext = breakdown.querySelector("[data-breakdown-next]");
          const bCount = breakdown.querySelector("[data-breakdown-count]");
          const bBody = breakdown.querySelector(".breakdown-content");
          let bIndex = 0;
          let bOpener = null;
          let bToContact = false;
          const showBreakdown = (i) => {
            bIndex = Math.max(0, Math.min(bSteps.length - 1, i));
            bSteps.forEach((el, k) => { el.hidden = k !== bIndex; });
            bPrev.disabled = bIndex === 0;
            bNext.disabled = bIndex === bSteps.length - 1;
            bCount.textContent = `${bIndex + 1} of ${bSteps.length}`;
            bBody.scrollTop = 0;
            const nextImg = bSteps[bIndex + 1]?.querySelector("img");
            if (nextImg) nextImg.loading = "eager";
          };
          const openBreakdown = (opener) => {
            bOpener = opener || null;
            showBreakdown(0);
            if (!breakdown.open) breakdown.showModal();
            if (location.hash !== hashName) history.replaceState(null, "", hashName);
            breakdown.querySelector("[data-breakdown-close]").focus();
          };
          document.addEventListener("click", (e) => { const b = e.target.closest(openSel); if (b) openBreakdown(b); });
          bPrev.addEventListener("click", () => showBreakdown(bIndex - 1));
          bNext.addEventListener("click", () => showBreakdown(bIndex + 1));
          breakdown.querySelector("[data-breakdown-close]").addEventListener("click", () => breakdown.close());
          breakdown.querySelector("[data-breakdown-contact]").addEventListener("click", () => {
            bToContact = true;
            breakdown.close();
            activateTab("contact");
            requestAnimationFrame(() => document.querySelector("#contact-message")?.focus());
          });
          breakdown.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") { e.preventDefault(); showBreakdown(bIndex + 1); }
            if (e.key === "ArrowLeft") { e.preventDefault(); showBreakdown(bIndex - 1); }
          });
          breakdown.addEventListener("click", (e) => {
            if (e.target !== breakdown) return;
            const r = breakdown.getBoundingClientRect();
            if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) breakdown.close();
          });
          breakdown.addEventListener("close", () => {
            if (location.hash === hashName) history.replaceState(null, "", location.pathname + location.search);
            if (bToContact) { bToContact = false; return; }
            bOpener?.focus();
          });
          if (location.hash === hashName) {
            const projects = document.querySelector('[data-tab-target="projects"]');
            if (projects) activateTab("projects");
            openBreakdown(null);
          }
        }

      };
      setupStepper("#breakdown-dialog", "[data-breakdown-open]", "#breakdown");
      setupStepper("#gallery-dialog", "[data-gallery-open]", "#gallery");
      document.querySelectorAll("[data-rotator]").forEach((box) => {
        const stage = box.querySelector(".rotator-stage") || box;
        const slides = [...stage.querySelectorAll(".rotator-slide")];
        if (slides.length < 2) return;
        const track = document.createElement("div");
        track.className = "review-track";
        slides.forEach((el) => track.appendChild(el));
        slides.forEach((el) => {
          const copy = el.cloneNode(true);
          copy.setAttribute("aria-hidden", "true");
          track.appendChild(copy);
        });
        stage.appendChild(track);
        stage.classList.add("review-window");
        track.style.setProperty("--review-time", slides.length * 14 + "s");
      });
      document.querySelectorAll("[data-rail]").forEach((box) => {
        const view = box.querySelector(".rail-viewport");
        const cards = [...view.querySelectorAll(".rail-card")];
        const track = document.createElement("div");
        track.className = "rail-track";
        cards.forEach((el) => track.appendChild(el));
        cards.forEach((el) => { const c = el.cloneNode(true); c.setAttribute("aria-hidden", "true"); track.appendChild(c); });
        view.appendChild(track);
        const all = [...track.children];
        const addMore = () => all.forEach((el, i) => {
          const q = el.querySelector("blockquote");
          if (q.scrollHeight <= q.clientHeight + 2) return;
          const b = document.createElement("button");
          b.type = "button"; b.className = "rail-more"; b.textContent = "Read more";
          if (el.getAttribute("aria-hidden")) b.tabIndex = -1;
          b.addEventListener("click", () => {
            const open = !el.classList.contains("is-open");
            [all[i % cards.length], all[i % cards.length + cards.length]].forEach((c) => { c.classList.toggle("is-open", open); c.querySelector(".rail-more").textContent = open ? "Show less" : "Read more"; });
          });
          q.after(b);
        });
        const waitVisible = () => { if (box.offsetParent) addMore(); else requestAnimationFrame(waitVisible); };
        waitVisible();
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
          box.classList.add("is-static");
          box.querySelector(".rail-prev").addEventListener("click", () => view.scrollBy({ left: -280, behavior: "smooth" }));
          box.querySelector(".rail-next").addEventListener("click", () => view.scrollBy({ left: 280, behavior: "smooth" }));
          return;
        }
        let pos = 0, last = 0, paused = false, boost = 0;
        const speed = 38; // px per second, cards travel left to right
        const half = () => track.scrollWidth / 2;
        const draw = () => { const h = half(); pos = ((pos % h) + h) % h; track.style.transform = "translateX(" + (pos - h) + "px)"; };
        const step = (t) => {
          const dt = Math.min((t - (last || t)) / 1000, 0.1);
          last = t;
          if (!paused) pos += speed * dt;
          if (boost) { const d = boost * Math.min(1, dt * 7); pos += d; boost -= d; if (Math.abs(boost) < 0.5) boost = 0; }
          if (box.offsetParent) draw();
          requestAnimationFrame(step);
        };
        box.addEventListener("mouseenter", () => { paused = true; });
        box.addEventListener("mouseleave", () => { paused = false; });
        box.addEventListener("focusin", () => { paused = true; });
        box.addEventListener("focusout", () => { paused = false; });
        const nudge = () => (cards[0].getBoundingClientRect().width || 280) + 12;
        box.querySelector(".rail-prev").addEventListener("click", () => { boost += nudge(); }); // brings the earlier card in from the left
        box.querySelector(".rail-next").addEventListener("click", () => { boost -= nudge(); });
        requestAnimationFrame(step);
      });

      document.querySelectorAll(".page-process-cta [data-tab-target]").forEach((button) => {
        button.addEventListener("click", () => activateTab(button.dataset.tabTarget));
      });

      document.querySelectorAll('[role="tablist"]').forEach((tabList) => {
        tabList.addEventListener("click", (event) => {
          const trigger = event.target.closest("[data-tab-target]");
          if (trigger) activateTab(trigger.dataset.tabTarget);
        });

        tabList.addEventListener("keydown", (event) => {
          const current = event.target.closest("[data-tab-target]");
          if (!current) return;

          const triggers = [...tabList.querySelectorAll("[data-tab-target]")];
          const currentIndex = triggers.indexOf(current);
          let nextIndex = currentIndex;

          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            nextIndex = (currentIndex + 1) % triggers.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            nextIndex = (currentIndex - 1 + triggers.length) % triggers.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = triggers.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          activateTab(triggers[nextIndex].dataset.tabTarget, { focus: true });
        });
      });

      document.addEventListener("click", (event) => {
        const link = event.target.closest('a[href^="#"]');
        if (!link) return;

        const target = decodeURIComponent(link.hash.slice(1));
        if (!tabPanels.has(target)) return;

        event.preventDefault();
        activateTab(target);
      });

      window.addEventListener("popstate", () => {
        const tabName = decodeURIComponent(location.hash.slice(1));
        activateTab(tabPanels.has(tabName) ? tabName : "home", { updateHistory: false });
      });

      const initialTab = decodeURIComponent(location.hash.slice(1));
      activateTab(tabPanels.has(initialTab) ? initialTab : "home", { updateHistory: false });

      const scrollProgress = document.querySelector(".home-scroll-progress span");
      const updateScrollProgress = () => {
        if (!scrollProgress) return;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
        scrollProgress.style.transform = `scaleX(${progress})`;
        root.classList.toggle("has-scrolled-home", window.scrollY > 180);
      };
      window.addEventListener("scroll", updateScrollProgress, { passive: true });
      window.addEventListener("resize", updateScrollProgress);
      requestAnimationFrame(updateScrollProgress);

      if (!prefersReducedMotion && "IntersectionObserver" in window) {
        const revealTargets = document.querySelectorAll(".toolbelt, .dashboard-card, .services-section .section-heading, .service-row, .about-section .about-copy, .contact-intro-card");
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -30px" });
        revealTargets.forEach((target) => {
          target.classList.add("scroll-reveal");
          revealObserver.observe(target);
        });
      }

      const visitCount = document.querySelector("#site-visit-count");
      const updateVisitCount = async () => {
        try {
          const response = await fetch("/api/visits", {
            method: "POST",
            headers: { Accept: "application/json" },
          });
          if (!response.ok) {
            throw new Error(`Visit counter request failed with status ${response.status}`);
          }

          const result = await response.json();
          if (!Number.isSafeInteger(result.value) || result.value < 0) {
            throw new Error("Visit counter returned an invalid value");
          }

          visitCount.textContent = `${new Intl.NumberFormat().format(result.value)} visits`;
        } catch (error) {
          console.error("Unable to update the site visit count.", error);
          visitCount.textContent = "Visits unavailable";
        }
      };
      updateVisitCount();

      const chatPanel = document.querySelector("#chat-panel");
      const chatLauncher = document.querySelector(".chat-launcher");
      const chatClose = document.querySelector(".chat-close");
      const chatThread = document.querySelector("#chat-thread");
      const chatResponses = {
        projects: {
          text: "Rex has built Shopify storefronts and product experiences for brands including PunkRIDE, Tour Flex, and Winx Wheels, plus an independent travel-tech project.",
          link: { href: "#projects", label: "Explore projects" },
        },
        services: {
          text: "Rex designs and builds business websites and Shopify stores, researches customers and offers, and creates copy and visuals for campaigns.",
          link: { href: "#services", label: "Explore services" },
        },
        contact: {
          text: "Send Rex a note or book a 30-minute intro call.",
          link: { href: "#contact", label: "View contact options" },
        },
      };

      const chatPrompts = document.querySelector(".chat-prompts");
      const chatCalendarView = document.querySelector("#chat-calendar-view");
      const chatCalendarBack = document.querySelector(".chat-calendar-back");
      const setChatCalendarOpen = (isOpen) => {
        chatPanel.classList.toggle("has-calendar", isOpen);
        chatThread.hidden = isOpen;
        chatPrompts.hidden = isOpen;
        chatCalendarView.hidden = !isOpen;
        if (isOpen) chatCalendarBack.focus();
      };

      const setChatOpen = (isOpen) => {
        chatPanel.hidden = !isOpen;
        chatLauncher.setAttribute("aria-expanded", String(isOpen));
        if (!isOpen) setChatCalendarOpen(false);
        if (isOpen) chatClose.focus();
        else chatLauncher.focus();
      };

      chatLauncher.addEventListener("click", () => {
        setChatOpen(chatPanel.hidden);
      });
      chatClose.addEventListener("click", () => setChatOpen(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !chatPanel.hidden) setChatOpen(false);
      });
      chatCalendarBack.addEventListener("click", () => setChatCalendarOpen(false));

      chatPrompts.addEventListener("click", (event) => {
        const prompt = event.target.closest("[data-chat-question]");
        if (!prompt) return;
        if (prompt.dataset.chatQuestion === "meeting") {
          setChatCalendarOpen(true);
          return;
        }

        const response = chatResponses[prompt.dataset.chatQuestion];
        if (!response) return;

        const userMessage = document.createElement("p");
        userMessage.className = "chat-message chat-message--user";
        userMessage.textContent = prompt.textContent.trim();
        chatThread.append(userMessage);

        const assistantMessage = document.createElement("div");
        assistantMessage.className = "chat-message chat-message--assistant";
        const answer = document.createElement("p");
        answer.textContent = response.text;
        assistantMessage.append(answer);

        const responseLinks = response.links ?? (response.link ? [response.link] : []);
        responseLinks.forEach(({ href, label, target }) => {
          const link = document.createElement("a");
          link.href = href;
          link.textContent = label;
          link.className = "chat-answer-link";
          if (target) {
            link.target = target;
            link.rel = "noopener noreferrer";
          }
          assistantMessage.append(link);
        });
        chatThread.append(assistantMessage);
        chatThread.scrollTop = chatThread.scrollHeight;
      });

      document.querySelector("#contact-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(event.currentTarget);
        const services = formData.getAll("services");
        const service = services.join(", ");
        const inquiry = {
          name: formData.get("name"),
          email: formData.get("email"),
          services,
          message: formData.get("message"),
        };
        try {
          await fetch(inquiryEndpoint, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify(inquiry),
            keepalive: true,
          });
        } catch (error) {
          console.error("Unable to save inquiry to Google Sheets.", error);
        }
        event.currentTarget.reset();
        document.querySelector("#form-note").textContent =
          "Thanks — your inquiry was sent successfully. I’ll be in touch soon.";
      });
    </script>
    <script>
      (function () {
        var cards = document.querySelectorAll("[data-process] .process-card");
        if (!cards.length || !("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.documentElement.classList.add("process-anim");
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } });
        }, { threshold: 0.2 });
        cards.forEach(function (c, i) { c.style.transitionDelay = i * 90 + "ms"; io.observe(c); });
      })();
    </script>
  </body>
</html>
