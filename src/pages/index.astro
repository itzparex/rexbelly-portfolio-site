---
import "../styles/global.css";
import {
  siClaude,
  siClickup,
  siCss,
  siDocker,
  siFigma,
  siGit,
  siGoogledrive,
  siHtml5,
  siJavascript,
  siMailchimp,
  siReact,
  siShopify,
  siTypescript,
  siWebflow,
  siWordpress,
  siZendesk,
} from "simple-icons";

const tools = [
  { name: "Shopify", icon: siShopify },
  { name: "Liquid", mark: "LQ", color: "#5eacff" },
  { name: "HTML5", icon: siHtml5 },
  { name: "CSS3", icon: siCss },
  { name: "JavaScript", icon: siJavascript, color: "#947a00" },
  { name: "React", icon: siReact },
  { name: "TypeScript", icon: siTypescript },
  { name: "Figma", icon: siFigma },
  { name: "Adobe Photoshop", mark: "Ps", color: "#31a8ff" },
  { name: "Canva", logo: "/tool-logos/canva.ico" },
  { name: "Klaviyo", logo: "/tool-logos/klaviyo.png" },
  { name: "Mailchimp", icon: siMailchimp },
  { name: "systeme.io", logo: "/tool-logos/systemeio.png" },
  { name: "Funnelish", logo: "/tool-logos/funnelish.svg" },
  { name: "ClickFunnels", logo: "/tool-logos/clickfunnels.png" },
  { name: "GoHighLevel", logo: "/tool-logos/gohighlevel.ico" },
  { name: "Gorgias", logo: "/tool-logos/gorgias.png" },
  { name: "Docker", icon: siDocker },
  { name: "Git", icon: siGit },
  { name: "Webflow", icon: siWebflow },
  { name: "WordPress", icon: siWordpress },
  { name: "Hermes AI", mark: "H", color: "#527a68" },
  { name: "Claude", icon: siClaude },
  { name: "Codex", mark: "CX", color: "#171717" },
  { name: "Google Workspace", icon: siGoogledrive },
  { name: "Zendesk", icon: siZendesk },
  { name: "Slack", logo: "/tool-logos/slack.png" },
  { name: "ClickUp", icon: siClickup },
  { name: "VS Code", logo: "/tool-logos/vscode.ico" },
];

const toolColor = (tool) => tool.color ?? `#${tool.icon?.hex ?? "3269ae"}`;

const projects = [
  {
    number: "01",
    type: "SHOPIFY STOREFRONT",
    name: "PunkRIDE",
    description:
      "A Shopify storefront for a new generation of electric riders. Built to make the product, the brand, and the ride feel unmistakable.",
    image:
      "https://www.punkride.com/cdn/shop/files/pr-home-hero-desktop-1600-20261015.avif?v=11440922375333104476",
    alt: "PunkRIDE electric scooter storefront",
    tags: ["Shopify", "Theme development", "Liquid"],
    url: "https://www.punkride.com",
    link: "Visit storefront",
    className: "project-card--wide",
  },
  {
    number: "02",
    type: "PRODUCT EXPERIENCES",
    name: "Tour Flex",
    description:
      "Four considered product-page experiences for golf pants, shorts, a range bag, and a performance glove.",
    image: "",
    art: "tour",
    alt: "",
    tags: ["Shopify", "Product pages", "Conversion"],
    url: "https://itzparex.github.io/rexbelly-portfolio/#work",
    link: "Explore the case study",
    className: "",
  },
  {
    number: "03",
    type: "INDEPENDENT PROJECT",
    name: "tripninja.io",
    description:
      "An independent travel-tech project, designed, built, and launched as a complete digital experience.",
    image:
      "https://cdn.prod.website-files.com/68338a6e127062351d6e3ca5/6838bdc6a951dba8b488e806_tripninja-map.webp",
    alt: "TripNinja travel map artwork",
    tags: ["Web design", "Front-end", "Independent"],
    url: "https://tripninja.io",
    link: "Visit tripninja.io",
    className: "",
  },
  {
    number: "04",
    type: "SHOPIFY PRODUCT PAGES",
    name: "Winx Wheels",
    description:
      "Product-page work for motorcycle gear, including armored riding pants, a USB-C accessory, and a half-shell helmet.",
    image:
      "https://winxwheels.com/cdn/shop/files/1784566999_0_600x.png?v=5226215491327965039",
    alt: "Winx Wheels motorcycle gear product imagery",
    tags: ["Shopify", "Product pages", "E-commerce"],
    url: "https://winxwheels.com",
    link: "Visit Winx Wheels",
    className: "",
  },
  {
    number: "05",
    type: "LIFECYCLE MARKETING",
    name: "A customer journey that keeps earning",
    description:
      "A segmented welcome, cart recovery, and retention program—paired with timely campaigns—contributed 25% of store revenue and over $120K in six months.",
    image: "",
    alt: "",
    tags: ["Klaviyo", "Segmentation", "Automation"],
    url: "https://itzparex.github.io/rexbelly-marketing/",
    link: "Read the marketing work",
    className: "project-card--result",
  },
];

const services = [
  {
    number: "01",
    eyebrow: "SHOPIFY · LIQUID",
    title: "Storefront & theme development",
    description:
      "From a rough brief to a live, considered storefront. I build Shopify themes, app integrations, and persuasive direct-response product pages designed to turn interest into action.",
    skills: ["Custom themes", "Liquid sections", "APIs & apps", "Aggressive direct-response product pages", "Launch support"],
  },
  {
    number: "02",
    eyebrow: "DESIGN · FRONT END",
    title: "Web design engineering",
    description:
      "One connected workflow from graphic design and interface design through implementation—across Webflow, WordPress, and hand-coded front ends.",
    skills: ["Graphic design", "Responsive design", "HTML / CSS / JS", "Webflow", "WordPress"],
  },
  {
    number: "03",
    eyebrow: "LIFECYCLE · AUTOMATION",
    title: "Marketing systems & management",
    description:
      "Conversion-focused funnels, email campaigns, and customer-first automation that connect the right message to the right moment in the customer journey.",
    skills: ["Funnels", "Email campaigns", "Klaviyo & Mailchimp", "GHL & systeme.io", "Gorgias", "Social & team management"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f1" />
    <meta
      name="description"
      content="Rexbelly P. Zipagan is a Shopify developer and web design engineer building thoughtful storefronts, product pages, and marketing systems from brief to launch."
    />
    <meta name="author" content="Rexbelly P. Zipagan" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rexbelly P. Zipagan" />
    <meta
      property="og:title"
      content="Rexbelly P. Zipagan | Shopify Developer & Web Design Engineer"
    />
    <meta
      property="og:description"
      content="Thoughtful Shopify storefronts, web experiences, and marketing systems—from brief to launch."
    />
    <meta property="og:image" content="https://rexbelly-portfolio-site.vercel.app/rex-portrait.jpg" />
    <meta
      property="og:image:alt"
      content="Rexbelly P. Zipagan — Shopify developer and web design engineer"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Rexbelly P. Zipagan | Shopify Developer & Web Design Engineer"
    />
    <meta
      name="twitter:description"
      content="Thoughtful Shopify storefronts, web experiences, and marketing systems—from brief to launch."
    />
    <meta name="twitter:image" content="https://rexbelly-portfolio-site.vercel.app/rex-portrait.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Rexbelly P. Zipagan | Shopify Developer &amp; Web Design Engineer</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Rexbelly P. Zipagan",
        "alternateName": "Rex",
        "jobTitle": "Shopify Developer & Web Design Engineer",
        "image": "https://rexbelly-portfolio-site.vercel.app/rex-portrait.jpg",
        "url": "https://rexbelly-portfolio-site.vercel.app/",
        "email": "rexbelly.zipagan@gmail.com",
        "knowsAbout": [
          "Shopify",
          "Liquid",
          "Web Design",
          "Front-end Development",
          "Email Marketing",
          "Marketing Automation"
        ]
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <aside class="sidebar" aria-label="Site navigation">
      <a class="sidebar-identity" href="#home" aria-label="Rexbelly P. Zipagan, home">
        <span class="sidebar-avatar-wrap">
          <img
            class="sidebar-portrait"
            src="/profile-avatar.png"
            alt="Illustrated profile avatar of Rexbelly P. Zipagan"
            width="768"
            height="768"
            fetchpriority="high"
          />
        </span>
        <span class="sidebar-name-line">
          <span class="sidebar-name">Rexbelly P. Zipagan</span>
          <span class="verified-badge" role="img" aria-label="Verified profile">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10.3 3.2 3.1L15.2 6.8" /></svg>
          </span>
        </span>
        <span class="sidebar-role">Shopify Developer</span>
        <span class="sidebar-handle">@itzparex · Philippines</span>
        <span class="sidebar-visits" id="site-visit-count" role="status" aria-live="polite">
          Loading visits…
        </span>
      </a>

      <div class="sidebar-socials" aria-label="Social and contact links">
        <a href="https://github.com/itzparex" target="_blank" rel="noreferrer" aria-label="GitHub">gh</a>
        <a href="https://itzparex.github.io/rexbelly-portfolio/#work" target="_blank" rel="noreferrer" aria-label="Portfolio archive">↗</a>
        <a href="mailto:rexbelly.zipagan@gmail.com" aria-label="Email">✉</a>
        <button class="theme-toggle theme-toggle--icon" type="button" aria-label="Switch to dark theme">
          <span class="theme-icon" aria-hidden="true">◐</span>
        </button>
      </div>

      <nav class="side-nav" role="tablist" aria-label="Portfolio pages" aria-orientation="vertical">
        <button class="nav-link is-active" id="tab-home" type="button" role="tab" aria-selected="true" aria-controls="panel-home" data-tab-target="home"><span class="nav-glyph" aria-hidden="true">⌂</span> Home</button>
        <button class="nav-link" id="tab-projects" type="button" role="tab" aria-selected="false" aria-controls="panel-projects" tabindex="-1" data-tab-target="projects"><span class="nav-glyph" aria-hidden="true">▱</span> Projects</button>
        <button class="nav-link" id="tab-services" type="button" role="tab" aria-selected="false" aria-controls="panel-services" tabindex="-1" data-tab-target="services"><span class="nav-glyph" aria-hidden="true">◈</span> Services</button>
        <button class="nav-link" id="tab-about" type="button" role="tab" aria-selected="false" aria-controls="panel-about" tabindex="-1" data-tab-target="about"><span class="nav-glyph" aria-hidden="true">☆</span> About</button>
        <button class="nav-link" id="tab-contact" type="button" role="tab" aria-selected="false" aria-controls="panel-contact" tabindex="-1" data-tab-target="contact"><span class="nav-glyph" aria-hidden="true">◌</span> Contact</button>
      </nav>

      <div class="sidebar-bottom">
        <span class="availability"><i aria-hidden="true"></i> Available for select projects</span>
        <p class="copyright">© 2026 Rexbelly P. Zipagan<br />All rights reserved.</p>
      </div>
    </aside>

    <div class="page-shell">
      <header class="mobile-header">
        <div class="mobile-header-top">
          <a class="mobile-brand" href="#home">Rexbelly<span>.</span></a>
          <div class="mobile-header-actions">
            <button class="theme-toggle theme-toggle--mobile" type="button" aria-label="Switch to dark theme">
              <span class="theme-icon" aria-hidden="true">◐</span>
            </button>
            <a class="mobile-contact" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <nav class="mobile-nav" role="tablist" aria-label="Portfolio pages">
          <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls="panel-home" data-tab-target="home">Home</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-projects" tabindex="-1" data-tab-target="projects">Projects</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-services" tabindex="-1" data-tab-target="services">Services</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-about" tabindex="-1" data-tab-target="about">About</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="panel-contact" tabindex="-1" data-tab-target="contact">Contact</button>
        </nav>
      </header>

      <main id="main">
        <div class="tab-panel" id="panel-home" role="tabpanel" aria-labelledby="tab-home" tabindex="0">
        <section class="hero section-wrap" id="home" aria-labelledby="hero-title">
          <div class="hero-header">
            <div>
              <span class="eyebrow">SHOPIFY STOREFRONTS · WEB DESIGN · MARKETING SYSTEMS</span>
              <h1 id="hero-title">Storefronts, from brief to launch.</h1>
              <p class="hero-subtitle">I help e-commerce teams turn good ideas into thoughtful storefronts and customer experiences.</p>
            </div>
            <a class="resource-button" href="#contact"><span aria-hidden="true">✦</span> Let’s work together</a>
          </div>
          <div class="hero-orbit hero-orbit--one" aria-hidden="true"></div>
          <div class="hero-orbit hero-orbit--two" aria-hidden="true"></div>
        </section>

        <section class="toolbelt" aria-label="Tools and technologies">
          <div class="toolbelt-label">
            <span class="eyebrow">THE TOOLKIT</span>
            <span>Good tools. Better outcomes.</span>
          </div>
          <div class="marquee-viewport">
            <div class="marquee-track">
              {Array.from({ length: 2 }).map((_, groupIndex) => (
                <div class="marquee-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
                  {tools.map((tool) => (
                    <span class="tool-chip" style={`--tool-color: ${toolColor(tool)}`}>
                      <span class="tool-logo" aria-hidden="true">
                        {tool.logo ? (
                          <img src={tool.logo} alt="" />
                        ) : tool.icon ? (
                          <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                            <path d={tool.icon.path} />
                          </svg>
                        ) : (
                          <span class="tool-monogram">{tool.mark}</span>
                        )}
                      </span>
                      {tool.name}
                    </span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="dashboard-wrap" aria-label="Portfolio overview">
          <div class="dashboard-grid">
            <article class="dashboard-card dashboard-profile">
              <div class="dashboard-portrait-wrap">
                <img
                  src="/rex-portrait.jpg"
                  alt="Portrait of Rexbelly P. Zipagan"
                  width="768"
                  height="768"
                  fetchpriority="high"
                />
              </div>
              <span class="eyebrow profile-overline">HI, I’M</span>
              <span class="profile-name-line">
                <h2>
                  <span class="profile-name-full">Rexbelly<br class="profile-name-break" /> P. Zipagan</span>
                  <span class="profile-name-short">Rex</span>
                </h2>
                <span class="verified-badge" role="img" aria-label="Verified profile">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10.3 3.2 3.1L15.2 6.8" /></svg>
                </span>
              </span>
              <span class="profile-rule"></span>
              <p class="profile-specialty">SHOPIFY DEVELOPER · WEB DESIGN ENGINEER</p>
              <p class="profile-summary">
                I build thoughtful Shopify storefronts and web experiences, taking projects from the first brief through launch.
              </p>
              <a class="profile-contact" href="mailto:rexbelly.zipagan@gmail.com">Let’s make something useful <span aria-hidden="true">↗</span></a>
            </article>

            <article class="dashboard-card dashboard-projects">
              <div class="dashboard-card-heading">
                <span class="tile-icon" aria-hidden="true">▰</span>
                <div>
                  <h2>Projects</h2>
                  <p>Storefronts and digital work, built from the first sketch to launch.</p>
                </div>
              </div>
              <a class="dashboard-project-preview" href="https://www.punkride.com" target="_blank" rel="noreferrer" aria-label="View the PunkRIDE Shopify storefront">
                <img
                  src="https://www.punkride.com/cdn/shop/files/pr-home-hero-desktop-1600-20261015.avif?v=11440922375333104476"
                  alt="PunkRIDE electric scooter storefront"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
                <span class="preview-caption"><b>PunkRIDE</b><span>Shopify storefront ↗</span></span>
              </a>
              <a class="dashboard-card-link" href="#projects">Explore selected work <span aria-hidden="true">↗</span></a>
            </article>

            <article class="dashboard-card dashboard-process">
              <div class="dashboard-card-heading">
                <span class="tile-icon" aria-hidden="true">↗</span>
                <div>
                  <h2>Brief to launch</h2>
                  <p>One connected process, from idea to live.</p>
                </div>
              </div>
              <ol class="process-steps">
                <li><span>01</span><div><strong>Understand</strong><small>Goals, audience & brief</small></div></li>
                <li><span>02</span><div><strong>Design</strong><small>Shape the experience</small></div></li>
                <li><span>03</span><div><strong>Build</strong><small>Bring it to life</small></div></li>
                <li><span>04</span><div><strong>Launch</strong><small>Test, polish & ship</small></div></li>
              </ol>
            </article>

            <article class="dashboard-card dashboard-credentials">
              <div class="dashboard-card-heading">
                <span class="tile-icon" aria-hidden="true">◉</span>
                <div>
                  <h2>Experience</h2>
                  <p>Built around the whole customer journey.</p>
                </div>
              </div>
              <div class="credential-stats">
                <div><strong>15<span>+</span></strong><span>years in e-commerce</span></div>
                <div><strong>01</strong><span>partner from brief to launch</span></div>
              </div>
              <a class="dashboard-card-link" href="#about">A little about me <span aria-hidden="true">↗</span></a>
            </article>

            <article class="dashboard-card dashboard-services">
              <div class="dashboard-card-heading">
                <span class="tile-icon" aria-hidden="true">▤</span>
                <div>
                  <h2>Services</h2>
                  <p>How I can help move your next project forward.</p>
                </div>
              </div>
              <a class="service-mini" href="#services"><span>Shopify storefronts</span><span>01</span></a>
              <a class="service-mini" href="#services"><span>Web design engineering</span><span>02</span></a>
              <a class="service-mini" href="#services"><span>Marketing automation</span><span>03</span></a>
              <a class="service-mini" href="#services"><span>Funnels</span><span>04</span></a>
              <a class="service-mini" href="#services"><span>Graphic design</span><span>05</span></a>
              <a class="service-mini" href="#services"><span>Email campaigns</span><span>06</span></a>
              <a class="service-mini" href="#services"><span>Aggressive direct-response product pages</span><span>07</span></a>
            </article>

            <article class="dashboard-card dashboard-testimonial">
              <div class="dashboard-card-heading">
                <span class="tile-icon" aria-hidden="true">❞</span>
                <div>
                  <h2>Kind words</h2>
                  <p>What people say about working together.</p>
                </div>
              </div>
              <div class="testimonial-list">
                <figure class="testimonial-review">
                  <span class="testimonial-review-label">Client review</span>
                  <blockquote>“Perfect experience, skilled and communicative.”</blockquote>
                  <figcaption>
                    <span class="testimonial-avatar" aria-hidden="true">TL</span>
                    <span class="testimonial-author"><strong>Trina Lo</strong><span>FreshInk Communications</span></span>
                  </figcaption>
                </figure>
                <figure class="testimonial-review">
                  <span class="testimonial-review-label">Client review</span>
                  <blockquote>“Rexbelly went above and beyond to serve our team. I appreciate his fast communication and skills!”</blockquote>
                  <figcaption>
                    <span class="testimonial-avatar" aria-hidden="true">CF</span>
                    <span class="testimonial-author"><strong>Chris Field</strong><span>Fieldtrip Inc.</span></span>
                  </figcaption>
                </figure>
              </div>
              <a class="dashboard-card-link" href="#about">More about my approach <span aria-hidden="true">↗</span></a>
            </article>
          </div>
        </section>
        </div>

        <div class="tab-panel" id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" tabindex="0" hidden>
        <section class="section-wrap work-section" id="projects" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow section-kicker">01 / SELECTED WORK</span>
              <h2 id="projects-title">Real projects.<br /><span>Built for the browser.</span></h2>
            </div>
            <p class="section-intro">A focused selection of storefronts, product experiences, and marketing systems. Built with care, and made to work in the real world.</p>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class:list={["project-card", project.className]}>
                <a class="project-image-link" href={project.url} target="_blank" rel="noreferrer" aria-label={`${project.link}: ${project.name}`}>
                  {project.image ? (
                    <img
                      class="project-image"
                      src={project.image}
                      alt={project.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : project.art === "tour" ? (
                    <div class="tour-art" aria-label="A stylized Shopify product page layout">
                      <div class="tour-art-window">
                        <div class="tour-art-toolbar"><i></i><i></i><i></i><span>TOUR FLEX · SHOP</span></div>
                        <div class="tour-art-content">
                          <div class="tour-art-photo"><span>BUILT TO MOVE</span><i></i></div>
                          <div class="tour-art-details">
                            <span class="tour-art-label">PERFORMANCE COLLECTION</span>
                            <b>Made for<br />the long game.</b>
                            <i class="tour-art-price">$—</i>
                            <span class="tour-art-swatch"></span>
                            <span class="tour-art-button">FIND YOUR FIT <b>→</b></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div class="result-art" aria-label="Lifecycle marketing program results">
                      <span class="result-art-label">LIFECYCLE PROGRAM</span>
                      <strong>25<span>%</span></strong>
                      <span>of store revenue</span>
                      <div class="result-art-line"></div>
                      <div class="result-art-foot"><b>$120K+</b><span>in six months</span></div>
                    </div>
                  )}
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="project-body">
                  <div class="project-meta"><span>{project.type}</span><span>{project.number} / 05</span></div>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <div class="tag-row">
                    {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                  <a class="project-link" href={project.url} target="_blank" rel="noreferrer">{project.link}<span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
          <a class="archive-link" href="https://itzparex.github.io/rexbelly-portfolio/#work" target="_blank" rel="noreferrer">
            More work in the portfolio archive <span aria-hidden="true">↗</span>
          </a>
        </section>
        </div>

        <div class="tab-panel" id="panel-services" role="tabpanel" aria-labelledby="tab-services" tabindex="0" hidden>
        <section class="services-section" id="services" aria-labelledby="services-title">
          <div class="section-wrap">
            <div class="section-heading">
              <div>
                <span class="eyebrow section-kicker">02 / WHAT I DO</span>
                <h2 id="services-title">One partner.<br /><span>The whole picture.</span></h2>
              </div>
              <p class="section-intro">Design, development, and marketing work better when they’re pulling in the same direction. I bring the pieces together.</p>
            </div>
            <div class="service-list">
              {services.map((service) => (
                <article class="service-row">
                  <span class="service-number">{service.number}</span>
                  <div class="service-content">
                    <span class="eyebrow">{service.eyebrow}</span>
                    <h3>{service.title}</h3>
                    <p>{service.description}</p>
                  </div>
                  <div class="service-skills">
                    {service.skills.map((skill) => <span>{skill}</span>)}
                  </div>
                  <span class="service-arrow" aria-hidden="true">↗</span>
                </article>
              ))}
            </div>
          </div>
        </section>
        </div>

        <div class="tab-panel" id="panel-about" role="tabpanel" aria-labelledby="tab-about" tabindex="0" hidden>
        <section class="about-section section-wrap" id="about" aria-labelledby="about-title">
          <div class="about-label">
            <span class="eyebrow section-kicker">03 / A LITTLE CONTEXT</span>
            <div class="about-monogram" aria-hidden="true"><span>R</span><i>.</i></div>
            <span class="about-caption">Curious by nature.<br />Practical by design.</span>
          </div>
          <div class="about-copy">
            <h2 id="about-title">I started with the customer.<br /><span>I still build for them.</span></h2>
            <p class="about-lead">I’m Rex—Shopify developer, web design engineer, and marketer. I’ve spent 15+ years working across e-commerce, creative, support, and team leadership.</p>
            <p>That range helps me connect the dots: understand the customer, shape a useful experience, build it for the platform, and get it ready to launch. No handoff gap between the idea and the implementation.</p>
            <div class="about-facts">
              <div><strong>Brief → launch</strong><span>One connected workflow</span></div>
              <div><strong>Design + code</strong><span>Considered, then built</span></div>
              <div><strong>15+ years</strong><span>Across e-commerce</span></div>
            </div>
            <div class="quote-card">
              <span class="quote-mark" aria-hidden="true">“</span>
              <blockquote>“Rexbelly went above and beyond to serve our team. I appreciate his fast communication and skills!”</blockquote>
              <span class="quote-credit">CLIENT FEEDBACK</span>
            </div>
          </div>
        </section>
        </div>

        <div class="tab-panel" id="panel-contact" role="tabpanel" aria-labelledby="tab-contact" tabindex="0" hidden>
        <section class="contact-section" id="contact" aria-labelledby="contact-title">
          <div class="section-wrap contact-wrap">
            <div>
              <span class="eyebrow section-kicker">04 / YOUR NEXT MOVE</span>
              <h2 id="contact-title">Have a good one<br />in mind? <span>Let’s build it.</span></h2>
              <p class="contact-copy">Tell me what you’re working on, what you want it to do, and where you’re getting stuck. We’ll take it from there.</p>
              <a class="contact-email" href="mailto:rexbelly.zipagan@gmail.com?subject=Project%20inquiry">
                rexbelly.zipagan@gmail.com <span aria-hidden="true">↗</span>
              </a>
            </div>
            <form class="contact-form" id="contact-form">
              <label for="contact-name">Your name</label>
              <input id="contact-name" name="name" autocomplete="name" placeholder="How should I address you?" required />
              <label for="contact-email">Email address</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
              <label for="contact-message">A little about the project</label>
              <textarea id="contact-message" name="message" rows="3" placeholder="What are you looking to build?" required></textarea>
              <button class="button button--primary" type="submit">Start a conversation <span aria-hidden="true">↗</span></button>
              <p class="form-note" id="form-note" aria-live="polite">Opens a pre-filled email in your mail app.</p>
            </form>
          </div>
        </section>
        </div>
      </main>

      <footer class="footer section-wrap">
        <a class="footer-brand" href="#home">rexbelly<span>.</span></a>
        <p>Thoughtful digital work, from brief to launch.</p>
        <span class="footer-year">© 2026</span>
      </footer>
    </div>
    <aside class="portfolio-chat" aria-label="Portfolio chat">
      <section
        class="chat-panel"
        id="chat-panel"
        role="dialog"
        aria-labelledby="chat-title"
        aria-describedby="chat-description"
        hidden
      >
        <header class="chat-header">
          <img src="/aris-chat-avatar.png" alt="" width="44" height="44" />
          <div class="chat-header-copy">
            <h2 id="chat-title">A.R.I.S.</h2>
            <p id="chat-description"><span aria-hidden="true"></span> Rex’s portfolio guide</p>
          </div>
          <button class="chat-close" type="button" aria-label="Close chat">×</button>
        </header>
        <div class="chat-thread" id="chat-thread" role="log" aria-live="polite" aria-relevant="additions">
          <p class="chat-message chat-message--assistant">
            Hi there! I can help you explore Rex’s work, services, or how to get in touch.
          </p>
        </div>
        <div class="chat-prompts" aria-label="Choose a topic">
          <button type="button" data-chat-question="projects">Show me your projects</button>
          <button type="button" data-chat-question="services">What services do you offer?</button>
          <button type="button" data-chat-question="contact">How can I contact Rex?</button>
        </div>
      </section>
      <button
        class="chat-launcher"
        type="button"
        aria-label="Open chat with A.R.I.S., Rex’s portfolio guide"
        aria-controls="chat-panel"
        aria-expanded="false"
      >
        <img src="/aris-chat-avatar.png" alt="" width="72" height="72" />
        <span class="chat-launcher-status" aria-hidden="true"></span>
        <span class="chat-tooltip" aria-hidden="true">How Can I Help?</span>
      </button>
    </aside>
    <div class="brand-cursor" aria-hidden="true">
      <span class="brand-cursor-orbit"></span>
      <span class="brand-cursor-star">✦</span>
    </div>
    <script>
      const root = document.documentElement;
      const themeButtons = document.querySelectorAll(".theme-toggle");
      const themeStates = document.querySelectorAll(".theme-state");
      const themeColor = document.querySelector('meta[name="theme-color"]');

      const brandCursor = document.querySelector(".brand-cursor");
      const customCursorEnabled =
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
        window.matchMedia("(hover: hover) and (pointer: fine)").matches;

      if (customCursorEnabled) {
        root.classList.add("has-brand-cursor");

        document.addEventListener("pointermove", (event) => {
          if (event.pointerType !== "mouse") return;

          brandCursor.style.left = `${event.clientX}px`;
          brandCursor.style.top = `${event.clientY}px`;
          brandCursor.classList.add("is-visible");

          const target = event.target instanceof Element ? event.target : null;
          const nativeTarget = target?.closest("input, textarea, select, [contenteditable='true']");
          brandCursor.classList.toggle("is-native", Boolean(nativeTarget));
          brandCursor.classList.toggle(
            "is-interactive",
            Boolean(target?.closest("a, button, [role='button'], [data-cursor-hover]")),
          );
        });

        window.addEventListener("pointerout", (event) => {
          if (!event.relatedTarget) brandCursor.classList.remove("is-visible");
        });

        document.addEventListener("pointerdown", () => brandCursor.classList.add("is-pressed"));
        document.addEventListener("pointerup", () => brandCursor.classList.remove("is-pressed"));
      }

      const dashboardCards = [...document.querySelectorAll(".dashboard-grid > .dashboard-card")];
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!prefersReducedMotion && typeof Element.prototype.animate === "function") {
        dashboardCards.forEach((card, index) => {
          card.animate(
            [
              { opacity: 0, transform: "translateY(22px) scale(0.985)" },
              { opacity: 1, transform: "translateY(0) scale(1)" },
            ],
            {
              duration: 560,
              delay: index * 75,
              easing: "cubic-bezier(0.23, 1, 0.32, 1)",
            },
          );
        });
      }

      if (!prefersReducedMotion && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        dashboardCards.forEach((card) => {
          card.addEventListener("pointermove", (event) => {
            if (event.pointerType !== "mouse") return;

            const bounds = card.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width;
            const y = (event.clientY - bounds.top) / bounds.height;
            card.style.setProperty("--card-rotate-x", `${((0.5 - y) * 5).toFixed(2)}deg`);
            card.style.setProperty("--card-rotate-y", `${((x - 0.5) * 5).toFixed(2)}deg`);
            card.style.setProperty("--card-pointer-x", `${(x * 100).toFixed(1)}%`);
            card.style.setProperty("--card-pointer-y", `${(y * 100).toFixed(1)}%`);
            card.classList.add("is-tilting");
          });

          card.addEventListener("pointerleave", () => {
            card.style.setProperty("--card-rotate-x", "0deg");
            card.style.setProperty("--card-rotate-y", "0deg");
            card.classList.remove("is-tilting");
          });
        });
      }

      const setTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem("rexbelly-theme", theme);
        themeStates.forEach((state) => {
          state.textContent = theme === "dark" ? "Dark" : "Light";
        });
        themeButtons.forEach((button) => {
          button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} theme`);
        });
        themeColor.setAttribute("content", theme === "dark" ? "#151512" : "#f6f5f1");
      };

      const savedTheme = localStorage.getItem("rexbelly-theme");
      if (savedTheme === "light" || savedTheme === "dark") setTheme(savedTheme);
      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          setTheme(root.dataset.theme === "dark" ? "light" : "dark");
        });
      });

      const tabPanels = new Map(
        [...document.querySelectorAll(".tab-panel")].map((panel) => [
          panel.id.replace("panel-", ""),
          panel,
        ]),
      );
      const tabTriggers = [...document.querySelectorAll("[data-tab-target]")];

      const activateTab = (tabName, { updateHistory = true, focus = false } = {}) => {
        const selectedPanel = tabPanels.get(tabName);
        if (!selectedPanel) return;

        tabPanels.forEach((panel, name) => {
          const selected = name === tabName;
          panel.hidden = !selected;
          panel.setAttribute("aria-hidden", String(!selected));
        });

        tabTriggers.forEach((trigger) => {
          const selected = trigger.dataset.tabTarget === tabName;
          trigger.classList.toggle("is-active", selected);
          trigger.setAttribute("aria-selected", String(selected));
          trigger.tabIndex = selected ? 0 : -1;
          if (selected) trigger.setAttribute("aria-current", "page");
          else trigger.removeAttribute("aria-current");
        });

        window.scrollTo(0, 0);

        if (updateHistory && location.hash !== `#${tabName}`) {
          history.pushState({ tabName }, "", `#${tabName}`);
        }

        if (focus) {
          tabTriggers.find((trigger) => trigger.dataset.tabTarget === tabName)?.focus();
        }
      };

      document.querySelectorAll('[role="tablist"]').forEach((tabList) => {
        tabList.addEventListener("click", (event) => {
          const trigger = event.target.closest("[data-tab-target]");
          if (trigger) activateTab(trigger.dataset.tabTarget);
        });

        tabList.addEventListener("keydown", (event) => {
          const current = event.target.closest("[data-tab-target]");
          if (!current) return;

          const triggers = [...tabList.querySelectorAll("[data-tab-target]")];
          const currentIndex = triggers.indexOf(current);
          let nextIndex = currentIndex;

          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            nextIndex = (currentIndex + 1) % triggers.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            nextIndex = (currentIndex - 1 + triggers.length) % triggers.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = triggers.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          activateTab(triggers[nextIndex].dataset.tabTarget, { focus: true });
        });
      });

      document.addEventListener("click", (event) => {
        const link = event.target.closest('a[href^="#"]');
        if (!link) return;

        const target = decodeURIComponent(link.hash.slice(1));
        if (!tabPanels.has(target)) return;

        event.preventDefault();
        activateTab(target);
      });

      window.addEventListener("popstate", () => {
        const tabName = decodeURIComponent(location.hash.slice(1));
        activateTab(tabPanels.has(tabName) ? tabName : "home", { updateHistory: false });
      });

      const initialTab = decodeURIComponent(location.hash.slice(1));
      activateTab(tabPanels.has(initialTab) ? initialTab : "home", { updateHistory: false });

      const visitCount = document.querySelector("#site-visit-count");
      const updateVisitCount = async () => {
        try {
          const response = await fetch("/api/visits", {
            method: "POST",
            headers: { Accept: "application/json" },
          });
          if (!response.ok) {
            throw new Error(`Visit counter request failed with status ${response.status}`);
          }

          const result = await response.json();
          if (!Number.isSafeInteger(result.value) || result.value < 0) {
            throw new Error("Visit counter returned an invalid value");
          }

          visitCount.textContent = `${new Intl.NumberFormat().format(result.value)} visits`;
        } catch (error) {
          console.error("Unable to update the site visit count.", error);
          visitCount.textContent = "Visits unavailable";
        }
      };
      updateVisitCount();

      const chatPanel = document.querySelector("#chat-panel");
      const chatLauncher = document.querySelector(".chat-launcher");
      const chatClose = document.querySelector(".chat-close");
      const chatThread = document.querySelector("#chat-thread");
      const chatResponses = {
        projects: {
          text: "Rex has built Shopify storefronts and product experiences for brands including PunkRIDE, Tour Flex, and Winx Wheels, plus an independent travel-tech project.",
          link: { href: "#projects", label: "Explore projects" },
        },
        services: {
          text: "Rex works across Shopify storefront and theme development, web design engineering, and marketing automation and management.",
          link: { href: "#services", label: "Explore services" },
        },
        contact: {
          text: "For project inquiries, send Rex a note. You can also use the contact form to share a few details.",
          link: { href: "#contact", label: "Go to contact" },
        },
      };

      const setChatOpen = (isOpen) => {
        chatPanel.hidden = !isOpen;
        chatLauncher.setAttribute("aria-expanded", String(isOpen));
        if (isOpen) chatClose.focus();
        else chatLauncher.focus();
      };

      chatLauncher.addEventListener("click", () => {
        setChatOpen(chatPanel.hidden);
      });
      chatClose.addEventListener("click", () => setChatOpen(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !chatPanel.hidden) setChatOpen(false);
      });

      document.querySelector(".chat-prompts").addEventListener("click", (event) => {
        const prompt = event.target.closest("[data-chat-question]");
        if (!prompt) return;

        const response = chatResponses[prompt.dataset.chatQuestion];
        if (!response) return;

        const userMessage = document.createElement("p");
        userMessage.className = "chat-message chat-message--user";
        userMessage.textContent = prompt.textContent.trim();
        chatThread.append(userMessage);

        const assistantMessage = document.createElement("div");
        assistantMessage.className = "chat-message chat-message--assistant";
        const answer = document.createElement("p");
        answer.textContent = response.text;
        assistantMessage.append(answer);

        const link = document.createElement("a");
        link.href = response.link.href;
        link.textContent = response.link.label;
        link.className = "chat-answer-link";
        assistantMessage.append(link);
        chatThread.append(assistantMessage);
        chatThread.scrollTop = chatThread.scrollHeight;
      });

      document.querySelector("#contact-form").addEventListener("submit", (event) => {
        event.preventDefault();
        const formData = new FormData(event.currentTarget);
        const subject = encodeURIComponent(`Project inquiry from ${formData.get("name")}`);
        const body = encodeURIComponent(
          `Hi Rex,\n\n${formData.get("message")}\n\nYou can reach me at ${formData.get("email")}.\n\n${formData.get("name")}`,
        );
        window.location.href = `mailto:rexbelly.zipagan@gmail.com?subject=${subject}&body=${body}`;
        document.querySelector("#form-note").textContent =
          "Your email draft is ready. Send it from your mail app when you’re ready.";
      });
    </script>
  </body>
</html>
